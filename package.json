{
  "name": "labbayk-umrah-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Installable, offline Umrah dua guide with repeat playback and a Tawaf/Sa'i counter.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && npx --yes serve@14.2.4 public -l 4173",
    "deploy:netlify": "node scripts/build.mjs && netlify deploy --prod --dir public",
    "deploy:vercel": "vercel deploy --prod"
  }
}
